DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/reqflow

JWT_SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# GitHub OAuth App — user login (scope: read:user, user:email)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
# generate: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_STATE_SECRET=

# GitHub App — repo connection (installation flow)
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_CLIENT_ID=your_github_app_client_id
# generate: python -c "f=open(r'YOURFILE.private-key.pem').read().strip(); print(f.replace('\r\n',r'\n').replace('\n',r'\n'))"
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=your-app-slug
GITHUB_APP_REDIRECT_URI=http://localhost:8000/api/v1/github/app/setup

# generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# generate: python -c "import secrets; print(secrets.token_hex(32))"
PASSWORD_PEPPER=

# External web search for elicitation (comparable_products).
# "" disables search (graceful fallback to model knowledge); "duckduckgo" uses the keyless endpoint.
SEARCH_PROVIDER=

APP_ENV=development
APP_DEBUG=false
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
AUTO_MIGRATE=true

# Eval harness LLM judge (tests/eval) — đọc từ .env.test, KHÔNG thuộc config ứng dụng.
# Judge dùng model mạnh CỐ ĐỊNH, tách khỏi provider của session agent.
# Provider: anthropic | openai | google | bedrock
JUDGE_PROVIDER=anthropic
JUDGE_MODEL=claude-3-5-sonnet-20241022
# Để trống thì test integration baseline sẽ bị skip
JUDGE_API_KEY=
# Chỉ dùng cho Bedrock:
#   - JUDGE_REGION: bắt buộc (vd us-east-1)
#   - IAM keys: JUDGE_API_KEY=access_key_id + JUDGE_SECRET_KEY=secret_access_key
#   - Bearer key: chỉ JUDGE_API_KEY, để trống JUDGE_SECRET_KEY
#   - JUDGE_MODEL dạng model id của Bedrock, vd anthropic.claude-3-5-sonnet-20241022-v2:0
JUDGE_REGION=us-east-1
JUDGE_SECRET_KEY=
