# Docker Compose production
COMPOSE_CONTAINER_PREFIX=reqflow
DOCKER_USERNAME=your_dockerhub_username
IMAGE_TAG=latest
APP_PORT=8000
WEB_CONCURRENCY=4

# Database connection URL
# Supports postgres://, postgresql://, or postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/reqflow

# JWT authentication
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# App-level encryption secrets
# Required in non-development
ENCRYPTION_KEY=
ENCRYPTION_KEY_PREVIOUS=
PASSWORD_PEPPER=

# GitHub OAuth login
# Required in non-development
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
GITHUB_STATE_SECRET=

# GitHub App integration for repo connection
# Required in non-development
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_APP_REDIRECT_URI=

# External search provider
# Empty = disabled, duckduckgo = keyless DuckDuckGo HTML search
SEARCH_PROVIDER=

# Enable decision graph writes
# Usually false in production
DECISION_GRAPH_ENABLED=false

# Runtime environment
# development / staging / production
APP_ENV=development
APP_DEBUG=false

# Allowed frontend origins
# For pydantic list, JSON array format is safest
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Run database migrations automatically on startup
AUTO_MIGRATE=true

# Max internal agent tool-loop turns per request
MAX_AGENT_TURNS=30

# Timeout for checking LLM provider health
LLM_PROVIDER_HEALTH_TIMEOUT_SECONDS=25.0

# Timeout for one agent turn
AGENT_TURN_TIMEOUT_SECONDS=90.0

# Summarize conversation every N turns
SUMMARY_TRIGGER_EVERY=6

# Max reflection critique retry rounds
MAX_CRITIQUE_ROUNDS=2

# Minimum critique score to pass
CRITIQUE_SCORE_THRESHOLD=0.7

# Coverage threshold below which a section is considered weak
LOW_COVERAGE_RATIO=0.34

# Minimum score for each readiness dimension
READINESS_DIMENSION_PASS=0.5

# Overall readiness threshold
READINESS_READY_THRESHOLD=0.7

# Enforce deterministic validation before draft readiness
ENFORCE_DETERMINISTIC_GATE=true

# Enable adaptive diagnosis loop
ENABLE_ADAPTIVE_DIAGNOSIS=true

# Max LLM judge calls during diagnosis
MAX_DIAGNOSIS_JUDGE_CALLS=1

# Max output token budget for analyze step
ANALYZE_MAX_TOKENS=6000

# Tool choice behavior
# auto = model may skip tools, required = must call a tool
TOOL_CHOICE_MODE=auto