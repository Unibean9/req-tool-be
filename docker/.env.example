# Docker Compose production
COMPOSE_CONTAINER_PREFIX=reqflow
DOCKER_USERNAME=your_dockerhub_username
IMAGE_TAG=latest
APP_PORT=8000
WEB_CONCURRENCY=4

POSTGRES_DB=reqflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-postgres-password

# Application configuration
DATABASE_URL=postgresql+asyncpg://postgres:change-this-postgres-password@postgres:5432/reqflow

APP_ENV=development
APP_DEBUG=false
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
AUTO_MIGRATE=true

# JWT and security
JWT_SECRET_KEY=change-this-to-a-random-secret-key-with-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
ENCRYPTION_KEY_PREVIOUS=
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
PASSWORD_PEPPER=

# GitHub OAuth App - user login
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_STATE_SECRET=

# GitHub App - repository connection
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_CLIENT_ID=your_github_app_client_id
# Generate: python -c "f=open(r'YOURFILE.private-key.pem').read().strip(); print(f.replace('\r\n',r'\n').replace('\n',r'\n'))"
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=your-app-slug
GITHUB_APP_REDIRECT_URI=http://localhost:8000/api/v1/github/app/setup

# External web search for elicitation.
# Leave empty to disable; "duckduckgo" uses the keyless HTML endpoint.
SEARCH_PROVIDER=duckduckgo

# Runtime knobs
DECISION_GRAPH_ENABLED=true
MAX_AGENT_TURNS=30
LLM_PROVIDER_HEALTH_TIMEOUT_SECONDS=25.0
AGENT_TURN_TIMEOUT_SECONDS=90.0
SUMMARY_TRIGGER_EVERY=6
MAX_CRITIQUE_ROUNDS=2
CRITIQUE_SCORE_THRESHOLD=0.7
ANALYZE_MAX_TOKENS=6000
TOOL_CHOICE_MODE=auto
